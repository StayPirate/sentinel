{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:earlyMondays",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 0,
  // Weekly regeneration of backend/uv.lock (the only lock file in this
  // repository). The pep621 manager extracts direct dependencies only, so
  // this is what keeps transitive dependencies current. Runs on the
  // default "before 4am on monday" schedule, aligned with
  // schedule:earlyMondays above.
  "lockFileMaintenance": {
    "enabled": true,
    "commitMessagePrefix": "chore(deps):"
  },
  // Fix PRs raised from GitHub vulnerability (Dependabot) alerts. They
  // bypass the weekly schedule by design. Requires the Dependency graph
  // and Dependabot alerts to be enabled and the Mend Renovate App to have
  // read access to Dependabot alerts — see docs/deployment.md (Workflow
  // Conventions, Python dependency updates and vulnerability response).
  // fix(deps): makes a merged security fix a release signal (patch) for
  // release-please, whereas routine chore(deps): updates never cut a
  // release on their own. Renovate appends alert rules after packageRules,
  // so this prefix overrides the per-manager chore(deps): prefixes below.
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "commitMessagePrefix": "fix(deps):"
  },
  // This repository overrides Renovate's default ignorePaths (inherited
  // from the "config:recommended" preset) to drop "**/tests/**" ONLY —
  // that pattern silently excluded backend/tests/conftest.py from every
  // manager, including the custom.regex manager below. Do NOT re-add
  // "**/tests/**" here — see docs/deployment.md (Testcontainers image
  // references) for the full root-cause analysis and why this override
  // is necessary.
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/__fixtures__/**"
  ],
  // Python dependencies pinned in the PEP 723 inline metadata of the
  // standalone scripts under scripts/ (e.g. aio-pika in
  // capture-ibs-rabbitmq.py). The pep723 manager matches no file unless
  // configured — see docs/deployment.md (Python dependency updates and
  // vulnerability response).
  "pep723": {
    "managerFilePatterns": ["/^scripts/[^/]+\\.py$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Docker images referenced by testcontainers fixtures in backend/tests/conftest.py — not detected by any built-in manager since they are plain string arguments in Python code, not a Dockerfile/compose/workflow declaration",
      "managerFilePatterns": ["backend/tests/conftest.py"],
      "matchStrings": [
        "#\\s*renovate:\\s*depName=(?<depName>[a-z0-9._-]+)\\s+\\w+\\s*=\\s*\\w+Container\\(\"[a-z0-9._/-]+:(?<currentValue>[^\"]+)\"\\)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Syft image used by both release-SBOM workflow paths",
      "managerFilePatterns": ["/.github/sbom-tools\\.env$/"],
      "matchStrings": [
        "SYFT_IMAGE=anchore/syft:(?<currentValue>v[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "anchore/syft"
    },
    {
      "customType": "regex",
      "description": "CycloneDX CLI validator image used by both release-SBOM workflow paths",
      "managerFilePatterns": ["/.github/sbom-tools\\.env$/"],
      "matchStrings": [
        "CYCLONEDX_CLI_IMAGE=cyclonedx/cyclonedx-cli:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "cyclonedx/cyclonedx-cli"
    },
    {
      "customType": "regex",
      "description": "Renovate validation container used by the advisory pull-request workflow",
      "managerFilePatterns": ["/.github/workflows/renovate-validation\\.yml$/"],
      "matchStrings": [
        "RENOVATE_IMAGE:\\s+renovate/renovate:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "renovate/renovate"
    },
    {
      "customType": "regex",
      "description": "Action version: inputs that the github-actions manager does not track (e.g. the Codecov CLI of codecov/codecov-action), each marked by a '# renovate: datasource=<datasource> depName=<name>' hint comment directly above it",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)\\s+version:\\s*\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Tool versions that a workflow downloads itself (e.g. shellcheck, shfmt, and actionlint in ci.yml), each marked by a '# renovate: datasource=<datasource> depName=<name>' hint comment directly above its <NAME>_VERSION: \"<version>\" env: entry",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)\\s+[A-Z0-9_]+_VERSION:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      // Release tags carry a 'v' prefix (v1.7.12) that the values omit,
      // because the download URLs add it; tags that are not versions
      // (shellcheck's 'latest' and 'stable') are dropped.
      "extractVersionTemplate": "^v?(?<version>\\d.*)$"
    },
    {
      "customType": "regex",
      "description": "Python tools run as 'uvx <package>@<version>' (bandit and pip-audit in ci.yml, and the bandit copy of the Makefile security target)",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/", "/^Makefile$/"],
      "matchStrings": [
        "uvx\\s+(?<depName>[A-Za-z0-9][A-Za-z0-9._-]*)@(?<currentValue>[^\\s\"']+)"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Browser assets loaded from unpkg: the Swagger UI of deploy-api-docs.yml and of the API's /docs page (backend/app/api/interactive_docs.py) — Renovate's cdnurl and html managers support cdnjs only",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^backend/app/api/interactive_docs\\.py$/"
      ],
      "matchStrings": [
        "https://unpkg\\.com/(?<depName>(?:@[a-z0-9._-]+/)?[a-z0-9._-]+)@(?<currentValue>[^/\\s\"']+)/"
      ],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Python (backend) requirements are open-ended floors (>=), so the default rangeStrategy never proposes an in-range update. update-lockfile refreshes backend/uv.lock (what CI and the image install via uv sync --locked) for in-range updates and replaces the range only when a new version falls outside it",
      "matchManagers": ["pep621"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Group Python (backend and PEP 723 script) minor and patch updates into a single PR, so a dependency shared by the backend and a script moves in both together",
      "matchManagers": ["pep621", "pep723"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python minor and patch dependencies",
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "description": "Python (backend and PEP 723 script) major updates get their own PR",
      "matchManagers": ["pep621", "pep723"],
      "matchUpdateTypes": ["major"],
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "description": "GitHub Actions updates, including with: version inputs (e.g. astral-sh/setup-uv, aquasecurity/trivy-action)",
      "matchManagers": ["github-actions"],
      "commitMessagePrefix": "ci(deps):"
    },
    {
      "description": "Versions that the custom managers track in the workflows, in .github/sbom-tools.env, and in the Makefile — tools used only by CI and by the developer's local checks",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".github/**", "Makefile"],
      "commitMessagePrefix": "ci(deps):"
    },
    {
      "description": "Swagger UI, loaded by the GitHub Pages site and by the API's /docs page: the image ships the second copy, so the PR that updates both is not a CI-only change. Placed after the rule above so that it also applies to the workflow copy",
      "matchPackageNames": ["swagger-ui-dist"],
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "description": "Docker image and ARG-templated digest updates (backend/Dockerfile)",
      "matchManagers": ["dockerfile"],
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "description": "The Python interpreter version (backend/Dockerfile ARG, backend/.python-version, backend/pyproject.toml requires-python) is bumped manually per docs/conventions.md (Runtime Version, Version Bump Checklist) for major/minor changes, across every manager that tracks it (dockerfile, pyenv, pep621). Patch-level freshness for the Docker base image is still delivered automatically via digest updates, which this rule does not touch.",
      "matchPackageNames": ["python"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "Docker image updates for testcontainers fixtures (backend/tests/conftest.py)",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["backend/tests/conftest.py"],
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "description": "Keep the uv version used by astral-sh/setup-uv (CI), the uv binary copied into the Docker image (COPY --from), and the uv_build range in backend/pyproject.toml [build-system] (the backend bundled in that binary; pep621 normalizes the name to uv-build) in sync — see backend/Dockerfile comment",
      "matchPackageNames": ["astral-sh/uv", "ghcr.io/astral-sh/uv", "uv-build"],
      "groupName": "uv version (CI + Docker image)"
    }
  ]
}
