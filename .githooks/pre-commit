#!/usr/bin/env bash
set -euo pipefail

echo "Running pre-commit checks..."

echo "  ruff check..."
(cd backend && uv run --locked ruff check .)

echo "  ruff format..."
(cd backend && uv run --locked ruff format --check .)

echo "  mypy..."
(cd backend && uv run --locked mypy app tests alembic)

echo "  unit tests..."
# Exit code 5 = "no tests collected" (no @pytest.mark.unit tests yet).
# Treat it as success so the hook doesn't block commits before the
# first unit test is added. -x stops at the first failure so its
# location is always the last thing printed, instead of being pushed
# out of view by the remaining tests in the run.
(cd backend && uv run --locked pytest -m unit --no-header -q -x) || [ $? -eq 5 ]

# --- Shell script checks (shellcheck + shfmt) ---
# Run only on staged shell files. Because shellcheck and shfmt are not
# part of the Python environment, the hook degrades gracefully with a
# warning when they are absent — CI remains the authoritative gate.
# See docs/conventions.md (Shell Scripting).
mapfile -t shell_files < <(
    git diff --cached --name-only --diff-filter=ACMR |
        grep -E '(\.sh$|^\.githooks/)' || true
)

if [[ ${#shell_files[@]} -gt 0 ]]; then
    echo "  shellcheck..."
    if command -v shellcheck >/dev/null 2>&1; then
        shellcheck "${shell_files[@]}"
    else
        echo "Warning: shellcheck not installed; skipping (CI will enforce)." >&2
    fi

    echo "  shfmt..."
    if command -v shfmt >/dev/null 2>&1; then
        shfmt -i 4 -ci -d "${shell_files[@]}"
    else
        echo "Warning: shfmt not installed; skipping (CI will enforce)." >&2
    fi
fi

# --- Secret scanning (gitleaks) ---
# Scans staged changes for secrets. Local-only: there is no CI job or
# GitHub Action for secret scanning (see
# docs/features/platform/testing-strategy.md, Pre-Commit Hooks), so
# this hook is the only enforcement point. No version is pinned; any
# recent release is expected to behave consistently for this use case.
echo "  gitleaks..."
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --staged
else
    echo "Warning: gitleaks not installed; skipping (local-only check, no CI enforcement)." >&2
fi
