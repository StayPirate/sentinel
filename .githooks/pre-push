#!/usr/bin/env bash
set -euo pipefail

# --- Guard: block direct pushes to master and local tag pushes ---
while IFS=' ' read -r local_ref _local_sha remote_ref _remote_sha; do
    if [[ "${remote_ref}" == "refs/heads/master" ]]; then
        echo "Error: direct push to master is not allowed. Use a pull request." >&2
        exit 1
    fi
    if [[ "${local_ref}" == refs/tags/* ]]; then
        echo "Error: local tag push is not allowed. Tags are created by release-please." >&2
        exit 1
    fi
done

echo "Running pre-push checks..."

echo "  full test suite..."
# Exit code 5 = "no tests collected". Treat as success for the same
# reason as pre-commit (see pre-commit script comments). -x stops at
# the first failure so its location is always the last thing printed,
# instead of being pushed out of view by the remaining tests in the
# run (or truncated by an external time limit on a long-running full
# suite before the run reaches its own completion summary).
# -m "not image" overrides the pyproject default marker filter so the
# local process system suite, which spawns real worker/Beat processes,
# runs inside this same parallel invocation. See
# docs/features/platform/testing-strategy.md (Local Process System
# Testing, Automation).
# The suite runs in parallel pytest-xdist workers, one per CPU up to 8;
# set PYTEST_XDIST_AUTO_NUM_WORKERS to use fewer. A crashed worker fails
# the run instead of being replaced, because a replacement would need a
# worker number outside the validated range. See
# docs/features/platform/testing-strategy.md (Parallel Execution).
(cd backend && uv run --locked pytest -m "not image" -n auto \
    --maxprocesses 8 --max-worker-restart 0 --no-header -q -x) ||
    [ $? -eq 5 ]
