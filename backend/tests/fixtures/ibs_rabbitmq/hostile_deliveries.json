{
  "description": "Synthetic hostile IBS RabbitMQ deliveries (no live capture). `body` is the exact UTF-8 text of the body, `body_hex` the exact bytes when they are not valid UTF-8. `expected.outcome` is `malformed` with its bounded reason category, or `valid` with the parsed package-commit identity (`project`, `package`) or request `number`. The oversized (about 1 MiB) unconsumed member and the deep-nesting and oversized-integer cases are generated by the tests.",
  "properties": "As deliveries.json, except routing_key, content_type, and content_encoding given per case",
  "cases": [
    {
      "id": "routing_key_unsupported",
      "routing_key": "suse.obs.package.build_success",
      "content_type": "application/octet-stream",
      "body": "{\"project\":\"SUSE:SLE-15-SP6:Update\",\"package\":\"example-pkg\",\"user\":\"example-user\",\"rev\":\"46\"}",
      "expected": {
        "outcome": "malformed",
        "reason": "unsupported_routing_key"
      }
    },
    {
      "id": "routing_key_empty",
      "routing_key": "",
      "content_type": "application/octet-stream",
      "body": "{\"project\":\"SUSE:SLE-15-SP6:Update\",\"package\":\"example-pkg\",\"user\":\"example-user\",\"rev\":\"46\"}",
      "expected": {
        "outcome": "malformed",
        "reason": "unsupported_routing_key"
      }
    },
    {
      "id": "routing_key_wildcard_shape",
      "routing_key": "suse.obs.package.#",
      "content_type": "application/octet-stream",
      "body": "{\"project\":\"SUSE:SLE-15-SP6:Update\",\"package\":\"example-pkg\",\"user\":\"example-user\",\"rev\":\"46\"}",
      "expected": {
        "outcome": "malformed",
        "reason": "unsupported_routing_key"
      }
    },
    {
      "id": "content_type_absent",
      "routing_key": "suse.obs.package.commit",
      "content_type": null,
      "body": "{\"project\":\"SUSE:SLE-15-SP6:Update\",\"package\":\"example-pkg\",\"user\":\"example-user\",\"rev\":\"46\"}",
      "expected": {
        "outcome": "malformed",
        "reason": "unsupported_content_type"
      }
    },
    {
      "id": "content_type_json",
      "routing_key": "suse.obs.package.commit",
      "content_type": "application/json",
      "body": "{\"project\":\"SUSE:SLE-15-SP6:Update\",\"package\":\"example-pkg\",\"user\":\"example-user\",\"rev\":\"46\"}",
      "expected": {
        "outcome": "malformed",
        "reason": "unsupported_content_type"
      }
    },
    {
      "id": "content_type_parameterized",
      "routing_key": "suse.obs.package.commit",
      "content_type": "application/octet-stream; charset=utf-8",
